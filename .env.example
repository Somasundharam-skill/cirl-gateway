# Bearer token the Perfox agent must send: "Authorization: Bearer <GATEWAY_API_KEY>"
GATEWAY_API_KEY=change-me-to-a-long-random-string

# Idle time before a conversation's session is dropped
SESSION_TTL_MINUTES=60

# Tools that tools/list shows and tools/call accepts (comma-separated; empty = this default).
# journey_turn runs the whole journey. The single-step tools (start_journey, record_consent,
# send_email_otp, verify_email_otp, create_password_link, check_password_status, start_kyc,
# defer_kyc, check_existing_eia, send_otp, verify_otp) are kept but disabled; add them here to enable.
ENABLED_TOOLS=journey_turn

# Per-tool CIRL mode: mock | real  ("real" is not implemented yet and fails safely)
CIRL_MODE_CHECK_EXISTING_EIA=mock
CIRL_MODE_SEND_OTP=mock
CIRL_MODE_VERIFY_OTP=mock
CIRL_MODE_SEND_EMAIL_OTP=mock

# 6-digit code accepted by the mock verify_email_otp
MOCK_EMAIL_OTP=123456

# Public address of this server, used in the password link: {PUBLIC_BASE_URL}/set-password?t=<token>
# (on Render, RENDER_EXTERNAL_URL is used if this is empty)
PUBLIC_BASE_URL=http://localhost:8000

# WhatsApp number for the "Return to WhatsApp" button on the password success page
WHATSAPP_NUMBER=+912269986221

# Privacy notice link shown in the journey_turn welcome text
PRIVACY_NOTICE_URL=[link]

LOG_LEVEL=INFO
