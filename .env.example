# Bearer token the Perfox agent must send: "Authorization: Bearer <GATEWAY_API_KEY>"
GATEWAY_API_KEY=change-me-to-a-long-random-string

# CSV with the columns phone,eia_no,name (relative paths are resolved against the project folder)
EMPLOYEE_DIRECTORY_PATH=data/employees.csv

# WEB-CHAT TESTING ONLY - NEVER SET THIS IN PRODUCTION.
# Used as the customer's phone when a request has no X-Sa-End-User-Phone header.
TEST_PHONE=

# Idle time before a conversation's session (and its verified status) is dropped
SESSION_TTL_MINUTES=60

LOG_LEVEL=INFO

# Per-API CIRL mode: mock | real  ("real" is not implemented yet and fails safely)
CIRL_MODE_SEND_OTP=mock
CIRL_MODE_VERIFY_OTP=mock
CIRL_MODE_GET_LIST_OF_POLICY=mock
